rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "ahmeda9a99a9@gmail.com";
    }

    function isNotBanned() {
      return isSignedIn() && (!exists(/databases/$(database)/documents/banned_users/$(request.auth.uid)));
    }

    // Public user profiles (name, bio, link, photoURL, createdAt)
    // NEVER contains email or private contact data
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isNotBanned();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Private user documents (email, internal security info, preferences)
    // ONLY readable and writable by the user themselves or verified admins
    match /users_private/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if (isOwner(userId) && isNotBanned()) || isAdmin();
    }

    // Apps collection
    match /apps/{appId} {
      // Anyone can read approved apps. Uploader can read their own app (pending/rejected). Admin can read all.
      allow read: if resource.data.status == 'approved' ||
                     (isSignedIn() && resource.data.uploaderId == request.auth.uid) ||
                     isAdmin();

      // Logged-in non-banned user can submit an app with 'pending' status
      allow create: if isSignedIn() && isNotBanned() &&
                       request.resource.data.uploaderId == request.auth.uid &&
                       request.resource.data.status == 'pending';

      // Updates:
      // 1. Admin can approve/reject/modify anything
      // 2. Owner can update metadata or upload new version (status stays pending)
      // 3. Anyone can increment download count counter
      allow update: if isAdmin() ||
                       (isSignedIn() && isNotBanned() && resource.data.uploaderId == request.auth.uid &&
                        request.resource.data.status == 'pending') ||
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads']) &&
                        request.resource.data.downloads == resource.data.downloads + 1);

      // Deletion allowed for owner or admin
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uploaderId == request.auth.uid);

      // Reviews subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        // Enforce 1 review per user by making reviewId == userId
        allow create: if isSignedIn() && isNotBanned() &&
                         reviewId == request.auth.uid &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.rating >= 1 &&
                         request.resource.data.rating <= 5;
        allow update: if isSignedIn() && isNotBanned() &&
                         resource.data.userId == request.auth.uid &&
                         request.resource.data.userId == request.auth.uid;
        allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
    }

    // Reports collection (viewable by admins only)
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isNotBanned() &&
                       request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Banned users collection
    match /banned_users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
